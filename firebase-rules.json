{
  "rules": {
    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && root.child('members').child(auth.uid).exists()",
        ".write": "auth != null && auth.uid === $uid && root.child('members').child(auth.uid).exists()"
      }
    },
    "shared": {
      "sessions": {
        ".read": "auth != null && root.child('members').child(auth.uid).exists()",
        "$id": {
          ".write": "auth != null && root.child('members').child(auth.uid).exists() && (!data.exists() || data.child('owner').val() === auth.uid || (!data.child('owner').exists() && data.child('updatedBy').val() === auth.uid)) && newData.exists() && newData.child('owner').val() === auth.uid",
          ".validate": "!newData.hasChild('lat') && !newData.hasChild('lng') && !newData.hasChild('memo') && !newData.hasChild('photos')"
        }
      }
    }
  }
}
